{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tenders-SA Desktop",
  "version": "0.1.0",
  "identifier": "com.tendersa.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tenders-SA Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NTZCNTIzMUFCRTBEQzgKUldUSURiNGFJN1ZXVnFIRTZLNG9LM2dZNm1wS3ppclBYWSthc0NOdGhDcm1Ud25JcmRPTVZYbm0K",
      "endpoints": [
        "https://github.com/Tenders-SA/tenders-sa-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
