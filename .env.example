# Runtime environment: development | staging | production
VITE_APP_ENV=development

# Tenders-SA backend API base URL. Must be https://, or http:// on
# localhost/127.0.0.1 for local development only. Never a production
# endpoint in this file — this is a developer input, not a secret store.
VITE_API_BASE_URL=http://localhost:3000

# Comma-separated list of allowed origins.
VITE_ALLOWED_ORIGINS=http://localhost:3000

# Feature flags. Risky/incomplete modules default off.
# Production native authentication stays disabled until the Phase 1
# auth/subscription contract (TASK-1.3) is accepted.
VITE_FEATURE_DESKTOP_AUTH=false

# Telemetry
VITE_TELEMETRY_ENABLED=false
VITE_TELEMETRY_REDACTION_MODE=strict

# Updater configuration placeholder. publicKey verifies signed update
# metadata; it is public material, never a signing secret (signing keys
# are approved-CI-only, per SEC-4).
VITE_UPDATE_CHANNEL=stable
VITE_UPDATE_PUBLIC_KEY=replace-with-tauri-updater-public-key

# Request policy
VITE_REQUEST_TIMEOUT_MS=10000
VITE_REQUEST_MAX_SAFE_RETRIES=2
