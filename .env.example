# OPTIONAL. The application starts and works without this file.
#
# Every value below has a working default, so a fresh clone and a packaged
# installer both run with no configuration at all. Copy this to `.env` only to
# point the application somewhere other than the live platform — most commonly
# a local backend.
#
# Anything you DO set is still validated strictly: a malformed value fails
# loudly at start-up with a screen naming the problem. The defaults remove
# "absent" as a failure mode, not "wrong".

# Runtime environment: development | staging | production
# Default: inferred from VITE_API_BASE_URL — localhost means development,
# anything else means production. Set it explicitly only for staging.
# VITE_APP_ENV=development

# The Tenders-SA application origin. Default: https://www.tenders-sa.org
#
# IMPORTANT: an origin is only usable if it also appears in the HTTP allow-list
# in `src-tauri/capabilities/default.json`. That list is a build-time security
# boundary, so pointing at a NEW origin is a code change, not configuration —
# without it the plugin denies every request and nothing loads.
# Currently allowed: https://www.tenders-sa.org and http://localhost:3000
# VITE_API_BASE_URL=http://localhost:3000

# Comma-separated. Default: the origin of VITE_API_BASE_URL.
# VITE_ALLOWED_ORIGINS=http://localhost:3000

# Authentication. Default: true.
# Set to false only to work offline against a backend that is down; the
# application then cannot sign in at all.
# VITE_FEATURE_DESKTOP_AUTH=true

# Telemetry. Defaults: disabled, strict redaction.
# VITE_TELEMETRY_ENABLED=false
# VITE_TELEMETRY_REDACTION_MODE=strict

# Updater. Defaults: stable channel, and a placeholder public key.
# The updater is not wired up, so the key is inert — it verifies nothing today.
# A real signed-update flow will need a real key and its own validation.
# VITE_UPDATE_CHANNEL=stable
# VITE_UPDATE_PUBLIC_KEY=replace-with-tauri-updater-public-key

# Request policy. Defaults: 10000 ms timeout, 2 retries on safe idempotent GETs.
# VITE_REQUEST_TIMEOUT_MS=10000
# VITE_REQUEST_MAX_SAFE_RETRIES=2
